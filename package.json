{
  "name": "quest",
  "version": "1.3.0",
  "description": "Coding agent harness following Anthropic engineering best practices",
  "type": "module",
  "bin": {
    "quest": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && cp src/dashboard/app.html dist/dashboard/app.html",
    "dev": "tsx src/cli.ts",
    "start": "node api/server.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.84",
    "@anthropic-ai/sdk": "^0.80.0",
    "@types/react": "^19.2.14",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "express": "^5.2.1",
    "ink": "^6.8.0",
    "react": "^19.2.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
